{
  "name": "Paciente",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome completo do paciente"
    },
    "idade": {
      "type": "number",
      "description": "Idade do paciente"
    },
    "paciente_id": {
      "type": "string",
      "description": "ID ou prontu\u00e1rio do paciente"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}